#!/bin/sh
# Checks one Common Lisp file with Allegro CL in batch mode.
#
# Usage: lisp-check [--test] FILE
# --test also loads the compiled file and runs its tester (util.test) assertions.
# If FILE's directory or a parent (up to the one holding .git) has *.asd files,
# those systems are loaded through ASDF first, so FILE can use their packages.
# LISP_BIN names the Lisp binary (default: alisp).
# Prints problems as FILE:LINE: STAGE: MESSAGE, then exactly one OK or FAIL line.
# Exit status: 0 OK, 1 the file has problems, 2 lisp-check could not run.

usage='Usage: lisp-check [--test] FILE'
lisp=${LISP_BIN:-alisp}

give_up() {
    echo "lisp-check: $1"
    echo FAIL
    exit 2
}

file=
test=
for arg in "$@"; do
    case $arg in
        --test) test=--test ;;
        -*) give_up "unknown option '$arg'. $usage" ;;
        *) [ -z "$file" ] || give_up "only one file at a time. $usage"
           file=$arg ;;
    esac
done
[ -n "$file" ] || give_up "no file given. $usage"
[ -f "$file" ] || give_up "$file: no such file"
[ -r "$file" ] || give_up "$file: not readable"
command -v "$lisp" >/dev/null 2>&1 \
    || give_up "Lisp binary '$lisp' not found. Install Allegro CL or set LISP_BIN to its path."

driver="$(cd "$(dirname "$0")" && pwd)/../lib/lisp-check.lisp"
"$lisp" -qq -batch -L "$driver" -e '(lisp-check::main)' -kill -- "$file" $test
status=$?
case $status in
    0|1) exit "$status" ;;
    *) give_up "$lisp stopped with exit status $status before finishing the check" ;;
esac
