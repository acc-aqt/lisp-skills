#!/bin/sh
# Builds the flat rules file for open harnesses from every skill in the plugin.
#
# Usage: scripts/export-rules [OUTPUT]   (default OUTPUT: dist/lisp-rules.md)
# PLUGIN_DIR overrides the plugin to read (default: plugins/lisp-skills).
set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
plugin_dir=${PLUGIN_DIR:-$root/plugins/lisp-skills}
out=${1:-$root/dist/lisp-rules.md}
essential_marker='<!-- essential -->'

frontmatter_value() {
    awk -v key="$2" '
        NR == 1 && $0 == "---" { inside = 1; next }
        inside && $0 == "---" { exit }
        inside && index($0, key ": ") == 1 { print substr($0, length(key) + 3); exit }
    ' "$1"
}

body() {
    awk '
        NR == 1 && $0 == "---" { inside = 1; next }
        inside && $0 == "---" { inside = 0; next }
        inside { next }
        !started && $0 == "" { next }
        { started = 1; print }
    ' "$1"
}

# nest_headings: shifts the Markdown headings on stdin so the highest one becomes
# ### and the whole text sits below "## <skill>". Lines in code fences are kept.
nest_headings() {
    awk '
        function level(line) { match(line, /^#+ /); return RLENGTH - 1 }
        { lines[NR] = $0 }
        /^(```|~~~)/ { fenced = !fenced; next }
        !fenced && /^#+ / && (top == 0 || level($0) < top) { top = level($0) }
        END {
            fenced = 0
            for (i = 1; i <= NR; i++) {
                line = lines[i]
                if (line ~ /^(```|~~~)/) {
                    fenced = !fenced
                } else if (!fenced && line ~ /^#+ /) {
                    line = substr("######", 1, level(line) - top + 3) substr(line, level(line) + 1)
                }
                print line
            }
        }
    '
}

export_skill() {
    skill_file=$1
    name=$(frontmatter_value "$skill_file" name)
    [ -n "$name" ] || name=$(basename "$(dirname "$skill_file")")
    printf '\n## %s\n\n' "$name"
    description=$(frontmatter_value "$skill_file" description)
    [ -z "$description" ] || printf '%s\n\n' "$description"
    body "$skill_file" | nest_headings
    for reference in "$(dirname "$skill_file")"/references/*.md; do
        [ -f "$reference" ] || continue
        [ "$(head -n 1 "$reference")" = "$essential_marker" ] || continue
        printf '\n'
        tail -n +2 "$reference" | nest_headings
    done
}

generate() {
    echo "<!-- GENERATED by scripts/export-rules from the skills in plugins/lisp-skills. Do not edit by hand; rebuild with: scripts/export-rules -->"
    echo
    echo "# Lisp rules"
    for skill_file in "$plugin_dir"/skills/*/SKILL.md; do
        [ -f "$skill_file" ] || continue
        export_skill "$skill_file"
    done
}

mkdir -p "$(dirname "$out")"
generate > "$out.tmp"
mv "$out.tmp" "$out"
